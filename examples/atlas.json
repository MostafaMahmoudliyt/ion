{
 "app": {
  "id": "atlas",
  "name": "Atlas Marketplace",
  "domain": "commerce"
 },
 "entities": [
  {
   "id": "customer",
   "name": "Customer",
   "type": "person",
   "attributes": [
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "email",
     "type": "email",
     "required": true,
     "unique": true
    },
    {
     "name": "phone",
     "type": "phone"
    },
    {
     "name": "loyalty_points",
     "type": "integer",
     "default": 0
    },
    {
     "name": "tier",
     "type": "enum",
     "values": [
      "basic",
      "silver",
      "gold"
     ],
     "default": "basic",
     "metadata": {
      "transitions": {
       "basic": [
        "silver"
       ],
       "silver": [
        "gold"
       ]
      }
     }
    }
   ],
   "metadata": {
    "indexed": [
     "email"
    ]
   }
  },
  {
   "id": "vendor",
   "name": "Vendor",
   "type": "organization",
   "attributes": [
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "email",
     "type": "email",
     "required": true,
     "unique": true
    },
    {
     "name": "rating",
     "type": "number"
    },
    {
     "name": "status",
     "type": "enum",
     "values": [
      "pending",
      "approved",
      "suspended"
     ],
     "default": "pending",
     "metadata": {
      "transitions": {
       "pending": [
        "approved"
       ],
       "approved": [
        "suspended"
       ],
       "suspended": [
        "approved"
       ]
      }
     }
    }
   ],
   "metadata": {
    "versioned": true
   }
  },
  {
