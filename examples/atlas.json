 "events": [
  {
   "id": "customer.ordered",
   "name": "Customer Ordered",
   "actor": "customer",
   "target": "order",
   "triggers": [
    {
     "action": "send_notification",
     "to": "customer",
     "message": "Order received"
    },
    {
     "action": "increment",
     "field": "customer.loyalty_points",
     "on": "actor",
     "by": 10
    },
    {
     "action": "log",
     "to": "audit"
    },
    {
     "action": "trigger_workflow",
     "workflow": "order.payment_requested"
    }
   ],
   "relationship": "customer_orders",
   "type": "create",
   "metadata": {
    "rate": {
     "max": 500,
     "per_seconds": 60
    }
   }
  },
  {
   "id": "order.payment_requested",
   "name": "Order Payment Requested",
   "actor": "customer",
   "target": "order",
   "triggers": [
    {
     "action": "send_notification",
     "to": "customer",
     "message": "Please pay"
    },
    {
     "action": "log",
     "to": "audit"
    }
   ]
  },
  {
   "id": "order.paid",
   "name": "Order Paid",
   "actor": "customer",
   "target": "order",
   "triggers": [
    {
     "action": "update_field",
     "field": "order.state",
     "value": "paid",
     "on": "target"
    },
    {
     "action": "send_email",
     "to": "customer",
     "subject": "Payment received",
     "body": "Thanks"
    },
    {
     "action": "trigger_workflow",
     "workflow": "order.packed"
    }
   ]
  },
  {
   "id": "order.packed",
   "name": "Order Packed",
   "actor": "customer",
   "target": "order",
   "triggers": [
    {
     "action": "update_field",
     "field": "order.state",
     "value": "packed",
     "on": "target"
    },
    {
     "action": "log",
     "to": "audit"
    },
    {
     "action": "trigger_workflow",
     "workflow": "order.shipped"
    }
   ]
  },
  {
   "id": "order.shipped",
   "name": "Order Shipped",
   "actor": "customer",
   "target": "order",
   "triggers": [
    {
     "action": "update_field",
     "field": "order.state",
     "value": "shipped",
     "on": "target"
    },
    {
     "action": "send_notification",
     "to": "customer",
     "message": "On its way"
    }
   ]
  },
  {
   "id": "order.delivered",
   "name": "Order Delivered",
   "actor": "courier",
   "target": "order",
   "triggers": [
    {
     "action": "update_field",
     "field": "order.state",
     "value": "delivered",
     "on": "target"
    },
    {
     "action": "increment",
     "field": "courier.deliveries_done",
     "on": "actor"
    },
    {
     "action": "call_webhook",
     "url": "https://example.com/hooks/delivered"
    },
    {
     "action": "log",
     "to": "audit"
    }
   ]
  },
  {
   "id": "line.added",
   "name": "Line Added",
   "actor": "order_item",
   "target": "product",
   "triggers": [
    {
     "action": "decrement",
     "field": "product.stock",
     "on": "target"
    },
    {
     "action": "increment",
     "field": "product.sold_count",
     "on": "target"
    }
   ],
   "relationship": "line_product",
   "type": "create",
   "metadata": {
    "rate": {
     "max": 2000,
     "per_seconds": 60
    }
   }
  },
  {
   "id": "vendor.approved",
   "name": "Vendor Approved",
   "actor": "vendor",
   "target": "product",
   "triggers": [
    {
     "action": "update_field",
     "field": "vendor.status",
     "value": "approved",
     "on": "actor"
    },
    {
     "action": "send_notification",
     "to": "vendor",
     "message": "Approved"
    },
    {
     "action": "log",
     "to": "audit"
    }
   ]
  },
  {
   "id": "product.published",
   "name": "Product Published",
   "actor": "vendor",
   "target": "product",
   "triggers": [
    {
     "action": "update_field",
     "field": "product.listing",
     "value": "live",
     "on": "target"
    },
    {
     "action": "log",
     "to": "audit"
    }
   ]
  },
  {
   "id": "review.posted",
   "name": "Review Posted",
   "actor": "customer",
   "target": "review",
   "triggers": [
    {
     "action": "send_notification",
     "to": "customer",
     "message": "Review posted"
    },
    {
     "action": "increment",
     "field": "customer.loyalty_points",
     "on": "actor",
     "by": 5
    }
   ],
   "relationship": "customer_reviews",
   "type": "create"
  },
  {
   "id": "ticket.opened",
   "name": "Ticket Opened",
   "actor": "customer",
   "target": "support_ticket",
   "triggers": [
    {
     "action": "send_notification",
     "to": "customer",
     "message": "Ticket opened"
    },
    {
     "action": "log",
     "to": "audit"
    }
   ],
   "relationship": "customer_tickets",
   "type": "create"
  }
 ]
