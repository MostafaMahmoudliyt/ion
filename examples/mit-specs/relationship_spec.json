{
  "relationship_spec": {
    "relationships": [
      {
        "id": "enrollment",
        "from": "student",
        "to": "course",
        "type": "many-to-many",
        "storage": {
          "table": "enrollments",
          "columns": [
            "student_id",
            "course_id",
            "grade",
            "enrolled_on"
          ]
        },
        "junction": {
          "table": "enrollments",
          "columns": [
            {
              "name": "student_id",
              "references": "students.id"
            },
            {
              "name": "course_id",
              "references": "courses.id"
            }
          ],
          "attributes": [
            {
              "name": "grade",
              "type": "number",
              "nullable": true
            },
            {
              "name": "enrolled_on",
              "type": "date",
              "nullable": true,
              "auto": true
            }
          ],
          "unique": [
            [
              "student_id",
              "course_id"
            ]
          ],
          "indexes": [
            [
              "course_id"
            ]
          ],
          "active_only": true
        },
        "apis": [
          {
            "method": "POST",
            "path": "/api/students/:fromId/enrollments",
            "operation": "create",
            "summary": "Create link Student -> Course (enrollment)"
          },
          {
            "method": "GET",
            "path": "/api/students/:fromId/enrollments",
            "operation": "read",
            "summary": "List Course linked from a Student"
          },
          {
            "method": "GET",
            "path": "/api/courses/:toId/enrollments",
            "operation": "read",
            "summary": "List Student linked to a Course"
          },
          {
            "method": "PATCH",
            "path": "/api/students/:fromId/enrollments/:toId",
            "operation": "update",
            "summary": "Update link Student -> Course (enrollment)"
          },
          {
            "method": "DELETE",
            "path": "/api/students/:fromId/enrollments/:toId",
            "operation": "delete",
            "summary": "Archive link Student -> Course (enrollment)"
          }
        ]
      },
