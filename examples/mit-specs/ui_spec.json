    "data_sources": [
      {
        "id": "students",
        "entity": "student",
        "labels": {
          "en": {
            "singular": "Student",
            "plural": "Students"
          }
        },
        "display": "name",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "widget": "text",
